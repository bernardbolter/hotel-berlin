DATABASE_URL=postgresql://user@localhost:5432/hotelberlin
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Schema changes ship as Payload migrations (see doc/dev/DATABASE.md):
#   npm run migrate:create <name>
#   npm run migrate
# Emergency hatch only. Must stay false in every worktree and in tests.
PAYLOAD_DATABASE_PUSH=false

# Mapbox — vector maps (homepage teaser, hero map tile, /neighbourhood)
# Create a token at https://account.mapbox.com/ (public token is fine for client-side use)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional server token for walking-directions during geocode (falls back to NEXT_PUBLIC_…)
# MAPBOX_ACCESS_TOKEN=

# Optional — defaults to mapbox/light-v11. Use your own style ID when ready, e.g. mapbox/your-username/style-id
# NEXT_PUBLIC_MAPBOX_STYLE_ID=mapbox/light-v11

# Geocode CLI / beforeChange hook: Nominatim User-Agent (required by OSM usage policy)
# NOMINATIM_USER_AGENT=HotelBerlinGeocode/1.0 (https://hotel-berlin.de)

# Set to 1 during seed / geocode CLI so the beforeChange hook does not double-call APIs
# SKIP_GEOCODE_HOOK=1

# Production: run `npm run migrate` on deploy. Do not enable schema push.

# ISR revalidation for places (optional in dev)
# REVALIDATE_SECRET=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# On Netcup use the public URL, e.g. https://preview.your-domain.com

# Cloudflare R2 — production media. Leave unset locally so uploads stay on disk.
# Account ID is in the Cloudflare dashboard (R2 overview). API token: Object Read & Write.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Public media origin (config only — never stored on the media record).
# Temporary r2.dev URL now; switch to https://media.hotel-berlin.de later (no data migration).
# NEXT_PUBLIC_MEDIA_URL=https://pub-xxxxxxxx.r2.dev

# Resend — meeting inquiry notification + confirmation emails (EU region)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Hotel Berlin, Berlin <noreply@hotel-berlin.de>

# Soft launch — one switch for preview / staging before the public domain switch.
# SOFT_LAUNCH=true (exact string) enables:
#   - HTTP Basic auth on every matched route, including /de, /en, and /admin
#     (set BASIC_AUTH_USER and BASIC_AUTH_PASSWORD; missing credentials fail closed)
#   - robots.txt as Disallow: /  (/robots.txt itself stays outside the matcher so
#     crawlers can read it without Basic auth)
#   - X-Robots-Tag: noindex, nofollow and <meta name="robots" content="noindex, nofollow">
# Unset SOFT_LAUNCH, or any value other than exactly "true", restores public indexing
# (allow /, disallow /admin/ and /api/). After verifying, leave it off in this worktree.
# SOFT_LAUNCH=true
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# Seed scripts refuse NODE_ENV=production unless this is exactly "true"
# ALLOW_PRODUCTION_SEED=true
